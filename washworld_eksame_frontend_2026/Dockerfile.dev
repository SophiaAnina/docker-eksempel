FROM node:22-alpine
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    WATCHPACK_POLLING=true

# Dependencies are installed in the image; the source code is bind-mounted at runtime
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
# --webpack: polling-based file watching works on Windows/macOS bind mounts
CMD ["npm", "run", "dev", "--", "--webpack"]
